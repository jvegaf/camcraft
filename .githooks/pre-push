#!/usr/bin/env bash
# What a push pays for, while the commit is still local.
#
# This is the hook that pays for the cheap trunk: `dev` does not run the corpus measurement on every
# push, so the push itself is the last moment to find out that a parser change moved the numbers. It
# runs the parts of the gate that a push can invalidate, chosen from the range being pushed — read from
# the remote-tracking branch, not from the working tree, so an uncommitted experiment never decides what
# is verified.
#
# Skipped work says so, with the reason. A hook that silently checks nothing is worse than no hook.
#
# CI runs the full `gate` on every push to `dev`, so clippy and tests are scoped to the crates the
# push touches when that can be determined; a root Cargo.toml/Cargo.lock change, or Rust outside a
# workspace crate, falls back to the whole workspace. `PRE_PUSH_FULL=1` forces the workspace-wide run.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

remote=${1:-origin}
url=${2:-}

zero_sha='0000000000000000000000000000000000000000'
ranges=()
have_any=false

# Git passes the refs being pushed on stdin: "<local ref> <local sha> <remote ref> <remote sha>".
# Derive the range from those refs so a new branch or a missing upstream does not collapse into the
# whole gate when the remote already tells us what is new.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  # Deleting a remote ref pushes no commits to verify here.
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi

  if [ "$remote_sha" != "$zero_sha" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    upstream=$(git for-each-ref --format='%(upstream:short)' "$local_ref" 2>/dev/null || true)
    if [ -n "$upstream" ] && git rev-parse --verify --quiet "$upstream" >/dev/null; then
      base="$upstream"
    else
      # No remote-tracking ref yet (a branch's first push): compare with the trunk it will be
      # merged into, preferring the target remote when it is known locally.
      base=$(git rev-parse --verify --quiet "refs/remotes/${remote}/dev" 2>/dev/null \
          || git rev-parse --verify --quiet "refs/remotes/${remote}/master" 2>/dev/null \
          || git rev-parse --verify --quiet 'origin/dev' 2>/dev/null \
          || git rev-parse --verify --quiet 'origin/master' 2>/dev/null \
          || true)
    fi
  fi

  if [ -z "${base:-}" ]; then
    echo "pre-push: no base to diff against for $local_ref; running the whole gate."
    ./scripts/check.sh
    exit $?
  fi

  ranges+=("$base..$local_sha")
  have_any=true
done

if ! $have_any; then
  echo "pre-push: nothing to push."
  exit 0
fi

changed=$(for r in "${ranges[@]}"; do git diff --name-only "$r"; done | sort -u)

if [ -z "$changed" ]; then
  echo "pre-push: nothing to push ($(printf '%s ' "${ranges[@]}")is empty)."
  exit 0
fi

run_clippy=false
run_tests=false
run_parity=false
scope_workspace=false
crates=()

# Workspace clippy/tests matter when the pushed Rust lives in a workspace crate or when the
# workspace manifests change. Rust outside crates/ (e.g. scripts/parity/measure) is handled by its
# own gate below, not by `cargo --workspace`.
if echo "$changed" | grep -qE '^Cargo\.(toml|lock)$'; then
  run_clippy=true
  run_tests=true
  scope_workspace=true
fi

if echo "$changed" | grep -qE '^crates/.+\.rs$|^crates/.+/Cargo\.toml$'; then
  run_clippy=true
  run_tests=true
  while IFS= read -r dir; do
    [ -n "$dir" ] && crates+=("$dir")
  done < <(echo "$changed" | sed -n 's#^crates/\([^/]*\)/.*#\1#p' | sort -u)
fi

echo "$changed" | grep -qE '^(fixtures/corpus/|crates/cam-(gerber|excellon|geom|import)/|scripts/parity/)' && run_parity=true

if [ "${PRE_PUSH_FULL:-}" = "1" ] && { $run_clippy || $run_tests; }; then
  scope_workspace=true
fi

# No recognised crate names means the Rust change is not a workspace crate (or only root files were
# matched above); fall back so we never silently skip the check.
if { $run_clippy || $run_tests; } && ! $scope_workspace && [ ${#crates[@]} -eq 0 ]; then
  scope_workspace=true
fi

echo "pre-push: pushing $(echo "$changed" | wc -l | tr -d ' ') changed file(s) over $(printf '%s ' "${ranges[@]}")"

pkg_args=()
scope_label="workspace"
if ! $scope_workspace && [ ${#crates[@]} -gt 0 ]; then
  for c in "${crates[@]}"; do
    pkg_args+=(-p "$c")
  done
  scope_label="crate(s): ${crates[*]}"
fi

if $run_clippy; then
  if [ "$scope_label" = "workspace" ]; then
    echo "pre-push: clippy -D warnings (workspace)"
    cargo clippy --workspace --all-targets -- -D warnings
  else
    echo "pre-push: clippy -D warnings ($scope_label)"
    cargo clippy "${pkg_args[@]}" --all-targets -- -D warnings
  fi
else
  echo "pre-push: clippy skipped (no workspace Rust or manifest changed)"
fi

if $run_tests; then
  if [ "$scope_label" = "workspace" ]; then
    echo "pre-push: cargo test (workspace)"
    cargo test --workspace
  else
    echo "pre-push: cargo test ($scope_label)"
    cargo test "${pkg_args[@]}"
  fi
else
  echo "pre-push: tests skipped (no workspace Rust or manifest changed)"
fi

if $run_parity; then
  echo "pre-push: the corpus still matches its goldens"
  ./scripts/parity/run.sh
else
  echo "pre-push: parity skipped (nothing pushed can move what the corpus measures)"
fi

