{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/build",
      "!*.lock",
      "!src-tauri/crates/**/benches/baselines",
      "!design",
      "!src/app.css",
      "!static",
      "!odd/tasks/065-f3-isolation.md",
      "!odd/tasks/066-f3-isolation-review-fixes.md",
      "!odd/tasks/067-f4-non-copper-clear.md",
      "!odd/tasks/068-e5-1-e5-5-dialects-writers.md",
      "!odd/tasks/069-e5-2-e5-4-exc-areas-toolchange-style.md",
      "!odd/tasks/070-camui-floating-studio.md",
      "!odd/tasks/071-e6-1-board-layer-identity.md",
      "!odd/tasks/072-e6-2-project-tree.md",
      "!odd/tasks/073-e6-3-operation-forms.md",
      "!odd/tasks/074-e6-4-tool-library-binding.md",
      "!odd/tasks/075-e6-5-shortcuts-save.md",
      "!odd/tasks/076-e6-6-pcb-preview-sim.md",
      "!odd/tasks/077-spike-tauri-webview.md",
      "!odd/tasks/078-spike-gpui-native.md",
      "!odd/tasks/079-tauri-migration-plan.md",
      "!pnpm-workspace.yaml",
      "!postcss.config.cjs",
      "!README.md",
      "!scripts/baseline/README.md",
      "!scripts/parity/README.md",
      "!src/routes/+layout.svelte",
      "!src-tauri/capabilities/default.json",
      "!svelte.config.js",
      "!vite.config.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "attributePosition": "multiline",
    "bracketSpacing": true,
    "useEditorconfig": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "useConst": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.svelte"
      ],
      "linter": {
        "rules": {
          "style": {
            "useConst": "on",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
